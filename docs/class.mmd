classDiagram
direction TB

class ClubParticipant {
  <<abstract>>
  +ClubParticipant(participantId, name)
  +String participantId
  +String name
  +getRole()* String
}

class ClubMember {
  +ClubMember(name, participantId)
  +getRole() String
  +purchaseMembership(membership: Membership) void
  +freezeMembership(membership: Membership) void
  +bookSession(session: TrainingSession) boolean
}

class Instructor {
  +Instructor(name, participantId)
  +getRole() String
  +createSession(session: TrainingSession) void
}

class Administrator {
  +Administrator(name, participantId)
  +getRole() String
  +viewHallOccupancy(hall: Hall) OccupancyReport
}

class IClassSchedule {
  <<interface>>
  +viewSchedule() Schedule : value
  +updateSchedule(session: TrainingSession) void
}

class Membership {
  +Membership(membershipId, startDate, endDate, accessControlSystem)
  +String membershipId
  +Date startDate
  +Date endDate
  +String state
  -AccessControlSystem accessControlSystem
  +freeze(startDate: Date, endDate: Date) void
  +reactivate() void
  +final validate() boolean
}

class Visit {
  +String visitId
  +Date visitDate
  +Visit(visitId, visitDate, session, member)
}

class AccessControlSystem {
  +AccessControlSystem()
  +checkAccess(member: ClubMember, membership: Membership) boolean
  +grantAccess(visit: Visit) boolean
}

class TrainingSession {
  +TrainingSession(sessionId, startTime, endTime, capacity, hall)
  +String sessionId
  +Date startTime
  +Date endTime
  +int capacity
  +Hall hall
  +reserveSeatIfAvailable() boolean
  +getAvailableSeats() int
  +validate() boolean
}

class Hall {
  +Hall(hallId, name, maxCapacity)
  +String hallId
  +String name
  +int maxCapacity
  +getOccupancy() int
  +getAvailableSeats() int
  +isWithinOpeningHours(startTime: Date, endTime: Date) boolean
}

ClubParticipant <|-- ClubMember
ClubParticipant <|-- Instructor
ClubParticipant <|-- Administrator
IClassSchedule <|.. ClubMember
IClassSchedule <|.. Instructor
IClassSchedule <|.. Administrator

ClubMember "1" --> "0..*" Membership : має
ClubMember "1" --> "0..*" Visit : створює
ClubMember --> TrainingSession : бронює
Instructor --> TrainingSession : створює
Administrator --> Hall : перевіряє
Administrator --> TrainingSession : переглядає розклад
TrainingSession --> Hall : проводиться у
TrainingSession "1" o-- "0..*" Visit : реєструє участь
Membership "1" o-- "0..*" Visit : фіксує відвідування
Membership ..> AccessControlSystem : перевіряє право доступу
AccessControlSystem --> ClubMember : перевіряє
AccessControlSystem --> Membership : перевіряє
AccessControlSystem --> Visit : надає доступ

note for Membership "validate() — фінальний метод; період freeze() задається датами"
note for ClubParticipant "getRole() — абстрактний метод, перевизначений у ClubMember, Instructor, Administrator"
note for TrainingSession "reserveSeatIfAvailable() атомарно резервує місце; конкурентно успішним може бути лише одне бронювання"
note for IClassSchedule "Schedule - тип значення результату, не окремий клас предметної області"
note for Administrator "OccupancyReport - тип значення результату, не окремий клас предметної області"
